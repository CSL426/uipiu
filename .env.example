GEMINI_API_KEY=

PORT=6464
NIDIN_MENU_API_BASE_URL=https://loctw-service-api.nidin.shop/shopper/v2

LLM_TIMEOUT_SECONDS=30
# 站長的 Nidin 手機號碼。用它在登入頁「Nidin 帳號」登入成功，就會自動成為管理員，
# 不需要另外設本站密碼
NIDIN_OWNER_PHONE=
# 加密「記住的 Nidin 密碼」用的 Fernet 金鑰；留空會在資料目錄自動產生金鑰檔
NIDIN_CREDENTIAL_KEY=
NIDIN_ADMIN_USERNAME=admin
NIDIN_ADMIN_PASSWORD=
NIDIN_COOKIE_SECURE=false

# 瀏覽器擴充功能 ID。unpacked 版已由 manifest 的 key 固定並內建在前端，留空即可；
# 只有上架商店、ID 改變時才需要填
VITE_NIDIN_EXTENSION_ID=
