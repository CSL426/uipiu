{
  "manifest_version": 3,
  "name": "Nidin 團購點餐站 憑證連結（非官方）",
  "version": "0.1.0",
  "key": "",
  "description": "非你訂官方產品。協助把你在 order.nidin.shop 的登入憑證連結到自架的團購點餐後台，免手動複製或開 F12。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://order.nidin.shop/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://order.nidin.shop/*"
      ],
      "js": [
        "dist/nidin-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:6464/*",
      "http://127.0.0.1:6464/*",
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "http://localhost:8000/*",
      "http://127.0.0.1:8000/*"
    ]
  }
}
